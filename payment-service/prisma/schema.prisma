// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum MerchantStatus {
  active
  inactive
}

enum TransactionCurrency {
  GTQ
  COP
  USD
}

enum TransactionType {
  payin
  payout
}

enum TransactionStatus {
  pending
  approved
  rejected
  failed
  completed
}

enum SettlementStatus {
  pending
  processed
  paid
}


model Merchant {
  id           String         @id @default(uuid())
  name         String         @db.VarChar(255)
  email        String         @unique @db.VarChar(255)
  apiKey       String         @unique @map("api_key") @db.VarChar(255)
  status       MerchantStatus
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  transactions Transaction[]
  settlements  Settlement[]

  @@map("merchants")
}

model Transaction {
  id                    String                   @id @default(uuid())
  merchantId            String                   @map("merchant_id")
  amount                Decimal                  @db.Decimal(12, 2)
  currency              TransactionCurrency
  type                  TransactionType
  status                TransactionStatus
  reference             String                   @unique @db.VarChar(255)
  metadata              Json?                    @db.JsonB
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  merchant              Merchant                 @relation(fields: [merchantId], references: [id])
  settlementTransaction SettlementTransaction?

  @@index([merchantId])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

model Settlement {
  id                    String                  @id @default(uuid())
  merchantId            String                  @map("merchant_id")
  totalAmount           Decimal                 @map("total_amount") @db.Decimal(14, 2)
  transactionCount      Int                     @map("transaction_count")
  status                SettlementStatus
  periodStart           DateTime                @map("period_start")
  periodEnd             DateTime                @map("period_end")
  createdAt             DateTime                @default(now()) @map("created_at")
  merchant              Merchant                @relation(fields: [merchantId], references: [id])
  transactions          SettlementTransaction[]

  @@index([merchantId])
  @@map("settlements")
}

model SettlementTransaction {
  settlementId  String      @map("settlement_id")
  transactionId String      @unique @map("transaction_id")
  settlement    Settlement  @relation(fields: [settlementId], references: [id])
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@id([settlementId, transactionId])
  @@map("settlement_transactions")
}
